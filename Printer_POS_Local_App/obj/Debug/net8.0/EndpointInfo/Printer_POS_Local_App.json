{
  "openapi": "3.0.1",
  "info": {
    "title": "Expand-horizon-printer-pos",
    "description": "API For POS PRINTER",
    "version": "v1"
  },
  "paths": {
    "/api/POS/ports": {
      "get": {
        "tags": [
          "POS"
        ],
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language for the response (e.g., en, ar, de)",
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/POS/scan": {
      "get": {
        "tags": [
          "POS"
        ],
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language for the response (e.g., en, ar, de)",
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/POS/payment": {
      "post": {
        "tags": [
          "POS"
        ],
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language for the response (e.g., en, ar, de)",
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/PosPaymentRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PosPaymentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PosPaymentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PosPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Printer/PrintTicket": {
      "post": {
        "tags": [
          "Printer"
        ],
        "summary": "Print booking ticket.",
        "description": "Sample request:\r\n            \r\nPOS /api/PrintTicket",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language for the response (e.g., en, ar, de)",
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "requestBody": {
          "description": "Booking ticket information.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/BookingTicketDto"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingTicketDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingTicketDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BookingTicketDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success response."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingTicketDto": {
        "type": "object",
        "properties": {
          "BookingNo": {
            "type": "string",
            "nullable": true
          },
          "client_name": {
            "type": "string",
            "nullable": true
          },
          "pickup_address": {
            "type": "string",
            "nullable": true
          },
          "drop_address": {
            "type": "string",
            "nullable": true
          },
          "trip_name": {
            "type": "string",
            "nullable": true
          },
          "trip_date": {
            "type": "string",
            "format": "date-time"
          },
          "Amount": {
            "type": "number",
            "format": "double"
          },
          "currency_code": {
            "type": "string",
            "nullable": true
          },
          "is_two_way": {
            "type": "boolean",
            "nullable": true
          },
          "client_nationality": {
            "type": "string",
            "nullable": true
          },
          "client_phone": {
            "type": "string",
            "nullable": true
          },
          "total_pax": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "lang_code": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PosPaymentRequest": {
        "type": "object",
        "properties": {
          "TrxType": {
            "type": "string",
            "nullable": true
          },
          "Amount": {
            "type": "number",
            "format": "double"
          },
          "RefNum": {
            "type": "string",
            "nullable": true
          },
          "ReceiptNum": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Bearer Authentication with JWT Token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}